# =============================================================================
# PSHA School Portal — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to version control.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database (MySQL 8+)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=psha_portal
DATABASE_USER=psha_user
DATABASE_PASSWORD=change_me_strong_password
DATABASE_CONNECTION_LIMIT=10

# Session & Security (REQUIRED — app will not start without SESSION_SECRET)
SESSION_SECRET=generate_a_long_random_string_at_least_64_chars
CSRF_SECRET=generate_another_long_random_string
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=28800000

# Uploads
UPLOAD_DIRECTORY=public/uploads
MAX_FILE_SIZE_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3

# Biometric / device API (required in production for device ingestion)
BIOMETRIC_API_KEY=change-me-device-api-secret

# Logging
LOG_LEVEL=info

# Production recommendations (uncomment when deploying)
# NODE_ENV=production
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=strict
# REDIS_URL=redis://127.0.0.1:6379
# BASE_URL=https://portal.psha.edu.ng

# Auto-seed when users table is empty (default: on in non-production)
# AUTO_SEED=true

# Boot behaviour (long-running process)
RUN_MIGRATIONS_ON_BOOT=true
AUTO_SEED=true

# Cloudinary (required for all file uploads in production / Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=psha
