<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Card | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/report-card.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/parent-sidebar') %>
    <div class="main-content">
      <header class="top-navbar no-print">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div>
            <div style="font-weight:600;">Report Card</div>
            <div class="text-muted" style="font-size:0.75rem;">
              Child academic report
              <% if (typeof selectedTerm !== 'undefined' && selectedTerm) { %>
                · <%= selectedTerm.name %>
              <% } %>
            </div>
          </div>
        </div>
      </header>
      <div class="page-content">
        <div class="no-print mb-4">
          <%- include('../partials/child-selector') %>
        </div>
        <% if (!selectedChild) { %>
          <div class="card"><p class="text-muted">Select a child to view their report card.</p></div>
        <% } else { %>
          <%- include('../partials/report-filters', {
            sessions: typeof sessions !== 'undefined' ? sessions : [],
            terms: typeof terms !== 'undefined' ? terms : [],
            filters: typeof filters !== 'undefined' ? filters : {},
            extraQuery: '<input type="hidden" name="child" value="' + selectedChild.id + '">'
          }) %>
          <div class="rc-actions no-print">
            <button type="button" class="btn btn-primary" onclick="window.print()">Print report card</button>
          </div>
          <%- include('../partials/report-card', { student: selectedChild, results: results || [] }) %>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
