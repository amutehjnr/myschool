<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/parent-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Upcoming events</div>
        </div>
      </header>
      <div class="page-content">
        <div class="card">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr><th>Event</th><th>Date</th><th>Time</th><th>Location</th></tr>
              </thead>
              <tbody>
                <% if (!events.length) { %>
                  <tr><td colspan="4" class="text-center text-muted">No upcoming events.</td></tr>
                <% } %>
                <% events.forEach(function(e) { %>
                  <tr>
                    <td><%= e.title %></td>
                    <td><%= formatDate(e.event_date) %></td>
                    <td><%= e.start_time || '—' %></td>
                    <td><%= e.location || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
