<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../partials/parent-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Attendance</div>
        </div>
      </header>
      <div class="page-content">
        <%- include('../partials/child-selector') %>
        <div class="card">
          <% if (selectedChild) { %>
            <p class="text-muted mb-4">Showing attendance for <strong><%= selectedChild.first_name %> <%= selectedChild.last_name %></strong></p>
          <% } %>
          <div class="table-responsive">
            <table class="table">
              <thead><tr><th>Date</th><th>Status</th><th>Notes</th></tr></thead>
              <tbody>
                <% if (!attendance.length) { %>
                  <tr><td colspan="3" class="text-center text-muted">No attendance records yet.</td></tr>
                <% } else { attendance.forEach(function(a) { %>
                  <tr>
                    <td><%= formatDate(a.attendance_date) %></td>
                    <td><span class="badge <%= statusBadgeClass(a.status) %>"><%= a.status %></span></td>
                    <td><%= a.notes || '—' %></td>
                  </tr>
                <% }) } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
