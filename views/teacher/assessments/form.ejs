<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/teacher-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;"><%= title %></div>
        </div>
        <a href="/teacher/assessments" class="btn btn-outline btn-sm">Back</a>
      </header>
      <div class="page-content">
        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="card" style="max-width:560px;">
          <form method="POST" action="/teacher/assessments">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="name">Name</label>
              <input type="text" id="name" name="name" class="form-control" required
                     placeholder="e.g. First Term CA 1" value="<%= assessment && assessment.name ? assessment.name : '' %>">
            </div>
            <div class="form-group">
              <label class="form-label" for="assessment_type">Type</label>
              <select id="assessment_type" name="assessment_type" class="form-control" required>
                <option value="ca">Continuous Assessment</option>
                <option value="test">Test</option>
                <option value="exam">Examination</option>
                <option value="assignment">Assignment</option>
              </select>
            </div>
            <div class="flex gap-4" style="flex-wrap:wrap;">
              <div class="form-group" style="flex:1;min-width:140px;">
                <label class="form-label" for="class_id">Class</label>
                <select id="class_id" name="class_id" class="form-control" required>
                  <option value="">—</option>
                  <% classes.forEach(function(c) { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group" style="flex:1;min-width:140px;">
                <label class="form-label" for="subject_id">Subject</label>
                <select id="subject_id" name="subject_id" class="form-control" required>
                  <option value="">—</option>
                  <% subjects.forEach(function(s) { %>
                    <option value="<%= s.id %>"><%= s.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="flex gap-4" style="flex-wrap:wrap;">
              <div class="form-group" style="flex:1;min-width:100px;">
                <label class="form-label" for="max_score">Max score</label>
                <input type="number" id="max_score" name="max_score" class="form-control" value="100" min="1" step="0.01">
              </div>
              <div class="form-group" style="flex:1;min-width:100px;">
                <label class="form-label" for="weight">Weight %</label>
                <input type="number" id="weight" name="weight" class="form-control" min="0" max="100" step="0.01" placeholder="Optional">
              </div>
              <div class="form-group" style="flex:1;min-width:140px;">
                <label class="form-label" for="assessment_date">Date</label>
                <input type="date" id="assessment_date" name="assessment_date" class="form-control">
              </div>
            </div>
            <% if (typeof terms !== 'undefined' && terms.length) { %>
            <div class="form-group">
              <label class="form-label" for="term_id">Term</label>
              <select id="term_id" name="term_id" class="form-control">
                <option value="">—</option>
                <% terms.forEach(function(t) { %>
                  <option value="<%= t.id %>" <%= t.is_current ? 'selected' : '' %>><%= t.name %> (<%= t.session_name %>)</option>
                <% }) %>
              </select>
            </div>
            <% } %>
            <button type="submit" class="btn btn-primary">Create & enter scores</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
