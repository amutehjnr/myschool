<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/teacher-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div>
            <div style="font-weight:600;"><%= assessment.name %></div>
            <div class="text-muted" style="font-size:0.75rem;"><%= assessment.class_name %> · <%= assessment.subject_name %> · Max <%= assessment.max_score %></div>
          </div>
        </div>
        <a href="/teacher/assessments" class="btn btn-outline btn-sm">Back</a>
      </header>
      <div class="page-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %>" data-auto-dismiss><%= flash.message %></div>
        <% } %>
        <% if (assessment.is_published) { %>
          <div class="alert alert-warning">This assessment is published. Scores are locked.</div>
        <% } %>
        <div class="card">
          <form method="POST" action="/teacher/assessments/<%= assessment.id %>/scores">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr><th>Student ID</th><th>Name</th><th>Score (0–<%= assessment.max_score %>)</th><th>Comment</th></tr>
                </thead>
                <tbody>
                  <% if (!rows.length) { %>
                    <tr><td colspan="4" class="text-center text-muted">No active students in this class.</td></tr>
                  <% } %>
                  <% rows.forEach(function(r) { %>
                    <tr>
                      <td><%= r.studentCode %>
                        <input type="hidden" name="student_id" value="<%= r.studentId %>">
                      </td>
                      <td><%= r.lastName %> <%= r.firstName %></td>
                      <td>
                        <input type="number" name="score" class="form-control" style="width:100px;"
                               min="0" max="<%= assessment.max_score %>" step="0.01"
                               value="<%= r.score != null ? r.score : '' %>"
                               <%= assessment.is_published ? 'readonly' : '' %>>
                      </td>
                      <td>
                        <input type="text" name="comment" class="form-control"
                               value="<%= r.comment || '' %>"
                               <%= assessment.is_published ? 'readonly' : '' %>>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!assessment.is_published && rows.length) { %>
              <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save scores</button>
              </div>
            <% } %>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
