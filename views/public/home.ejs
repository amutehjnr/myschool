  <!-- ============ SCRIPTS ============ -->
  <script>
    // ---- Hero Carousel ----
    (function () {
      var root = document.getElementById('heroCarousel');
      if (!root) return;
      var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
      var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dots button'));
      var progress = document.getElementById('heroProgress');
      var indexEl = document.getElementById('heroIndex');
      var i = 0, timer = null, progressTimer = null;
      var INTERVAL = 2000, started = 0;

      function pad(n) { return n < 10 ? '0' + n : String(n); }

      function go(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
        dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === i); });
        if (indexEl) indexEl.textContent = pad(i + 1);
        restartProgress();
      }
      function next() { go(i + 1); }
      function prev() { go(i - 1); }

      function restartProgress() {
        if (progressTimer) cancelAnimationFrame(progressTimer);
        if (progress) progress.style.width = '0%';
        started = performance.now();
        function tick(now) {
          var p = Math.min(1, (now - started) / INTERVAL);
          if (progress) progress.style.width = (p * 100) + '%';
          if (p < 1) progressTimer = requestAnimationFrame(tick);
        }
        progressTimer = requestAnimationFrame(tick);
        if (timer) clearInterval(timer);
        timer = setInterval(next, INTERVAL);
      }

      root.querySelector('.hero-nav.next').addEventListener('click', next);
      root.querySelector('.hero-nav.prev').addEventListener('click', prev);
      dots.forEach(function (d) {
        d.addEventListener('click', function () { go(Number(d.getAttribute('data-go'))); });
      });

      root.addEventListener('mouseenter', function () {
        if (timer) clearInterval(timer);
        if (progressTimer) cancelAnimationFrame(progressTimer);
      });
      root.addEventListener('mouseleave', restartProgress);

      // Pause when tab hidden (saves CPU)
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          if (timer) clearInterval(timer);
          if (progressTimer) cancelAnimationFrame(progressTimer);
        } else {
          restartProgress();
        }
      });

      restartProgress();
    })();

    // ---- Mobile nav toggle ----
    (function () {
      var toggle = document.querySelector('.public-nav-toggle');
      var links = document.querySelector('.public-nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', function () {
          links.classList.toggle('open');
        });
      }
    })();

    // ---- Footer year ----
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
