<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle aria-label="Toggle menu">☰</button>
          <div style="font-weight:600;"><%= title %></div>
        </div>
        <a href="/admin/roles" class="btn btn-outline btn-sm">Back to roles</a>
      </header>

      <div class="page-content">
        <div class="card" style="max-width:640px;">
          <p class="text-muted mb-4">Select the permissions for the <strong><%= role.name %></strong> role.</p>

          <form method="POST" action="/admin/roles/<%= role.id %>/permissions">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <% Object.keys(grouped).forEach(function(mod) { %>
              <div class="mb-4">
                <h3 style="font-size:0.9rem; text-transform:uppercase; color:var(--color-text-muted); margin-bottom:8px;"><%= mod %></h3>
                <% grouped[mod].forEach(function(p) { %>
                  <label style="display:flex; align-items:flex-start; gap:10px; margin-bottom:8px; cursor:pointer;">
                    <input type="checkbox" name="permissions" value="<%= p.id %>" <%= p.assigned ? 'checked' : '' %> style="margin-top:3px;">
                    <span>
                      <strong style="font-size:0.875rem;"><%= p.code %></strong>
                      <% if (p.description) { %>
                        <span class="text-muted" style="font-size:0.8rem; display:block;"><%= p.description %></span>
                      <% } %>
                    </span>
                  </label>
                <% }) %>
              </div>
            <% }) %>

            <div class="flex gap-2">
              <button type="submit" class="btn btn-primary">Save permissions</button>
              <a href="/admin/roles" class="btn btn-outline">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
