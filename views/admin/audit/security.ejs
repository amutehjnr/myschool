<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Security posture</div>
        </div>
        <a href="/admin/audit" class="btn btn-outline btn-sm">Audit log</a>
      </header>
      <div class="page-content">
        <div class="card mb-4">
          <p class="text-muted">
            Runtime security checklist. Items marked fail should be fixed before production go-live.
            <% if (isProd) { %><span class="badge badge-warning">Production mode</span><% } else { %><span class="badge badge-info">Development mode</span><% } %>
          </p>
        </div>
        <div class="card">
          <table class="table">
            <thead>
              <tr><th>Check</th><th>Status</th><th>Detail</th></tr>
            </thead>
            <tbody>
              <% checks.forEach(function(c) { %>
                <tr>
                  <td><strong><%= c.name %></strong></td>
                  <td>
                    <% if (c.ok) { %>
                      <span class="badge badge-success">Pass</span>
                    <% } else { %>
                      <span class="badge badge-danger">Fail</span>
                    <% } %>
                  </td>
                  <td class="text-muted"><%= c.detail %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="card mt-4">
          <h2 class="card-title mb-2">Built-in controls</h2>
          <ul style="padding-left:18px;margin:0;line-height:1.7;">
            <li>Argon2id password hashing with forced change on first login</li>
            <li>Session regeneration after login; httpOnly cookies; SameSite</li>
            <li>CSRF tokens on all browser forms</li>
            <li>RBAC + object-level checks (parent/student data isolation)</li>
            <li>Rate limits on login, reset, admissions, uploads, device API</li>
            <li>Helmet CSP, HSTS (production), nosniff, referrer policy</li>
            <li>Device API key auth (no session) for biometric ingestion</li>
            <li>Idempotent biometric events; randomised upload filenames</li>
            <li>Audit trail for sensitive actions</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
