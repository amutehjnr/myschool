<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit Detail | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Audit entry #<%= log.id %></div>
        </div>
        <a href="/admin/audit" class="btn btn-outline btn-sm">Back</a>
      </header>
      <div class="page-content">
        <div class="card" style="max-width:640px;">
          <p><strong>Time:</strong> <%= formatDate(log.created_at) %></p>
          <p class="mt-2"><strong>User:</strong> <%= log.user_email || 'System / anonymous' %></p>
          <p class="mt-2"><strong>Action:</strong> <code><%= log.action %></code></p>
          <p class="mt-2"><strong>Module:</strong> <%= log.module || '—' %></p>
          <p class="mt-2"><strong>Record ID:</strong> <%= log.record_id || '—' %></p>
          <p class="mt-2"><strong>Status:</strong> <span class="badge <%= log.status === 'success' ? 'badge-success' : 'badge-danger' %>"><%= log.status %></span></p>
          <p class="mt-2"><strong>IP:</strong> <%= log.ip_address || '—' %></p>
          <p class="mt-2"><strong>User agent:</strong> <span class="text-muted" style="font-size:0.8rem;word-break:break-all;"><%= log.user_agent || '—' %></span></p>
          <% if (metadata) { %>
            <hr style="margin:16px 0;border:none;border-top:1px solid var(--color-border);">
            <p><strong>Metadata</strong></p>
            <pre style="background:#f8fafc;padding:12px;border-radius:6px;font-size:0.8rem;overflow:auto;"><%= typeof metadata === 'string' ? metadata : JSON.stringify(metadata, null, 2) %></pre>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
