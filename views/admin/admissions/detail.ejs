<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Application review</div>
        </div>
        <a href="/admin/admissions" class="btn btn-outline btn-sm">Back to list</a>
      </header>
      <div class="page-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %>" data-auto-dismiss><%= flash.message %></div>
        <% } %>

        <div class="card mb-4">
          <div class="flex justify-between items-center" style="flex-wrap:wrap;gap:12px;">
            <div>
              <h1 style="font-size:1.25rem;font-weight:600;"><%= application.reference_number %></h1>
              <p class="text-muted"><%= application.applicant_first_name %> <%= application.applicant_last_name %></p>
            </div>
            <span class="badge <%= statusBadgeClass(application.status) %>"><%= application.status %></span>
          </div>
          <div class="stats-grid" style="margin-top:20px;">
            <div><div class="text-muted" style="font-size:0.75rem;">Class applied</div><div><%= application.applying_for_class || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Date of birth</div><div><%= application.date_of_birth ? formatDate(application.date_of_birth) : '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Gender</div><div><%= application.gender || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Previous school</div><div><%= application.previous_school || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Parent</div><div><%= (application.parent_first_name || '') + ' ' + (application.parent_last_name || '') %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Parent contact</div><div><%= application.parent_email || application.parent_phone || '—' %></div></div>
          </div>
          <% if (application.address) { %><p class="mt-4"><strong>Address:</strong> <%= application.address %></p><% } %>
          <% if (application.notes) { %><p class="mt-2"><strong>Applicant notes:</strong> <%= application.notes %></p><% } %>
        </div>

        <div class="card mb-4">
          <h2 class="card-title mb-2">Documents</h2>
          <% if (!application.documents || !application.documents.length) { %>
            <p class="text-muted">No documents uploaded.</p>
          <% } else { %>
            <table class="table">
              <thead><tr><th>File</th><th>Type</th><th>Size</th><th></th></tr></thead>
              <tbody>
                <% application.documents.forEach(function(d) { %>
                  <tr>
                    <td><%= d.original_filename %></td>
                    <td><%= d.document_type %></td>
                    <td><%= Math.round(d.file_size/1024) %> KB</td>
                    <td><a href="/admin/admissions/<%= application.id %>/documents/<%= d.id %>" class="btn btn-outline btn-sm">Download</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <% if (transitions && transitions.length) { %>
          <div class="card" style="max-width:520px;">
            <h2 class="card-title mb-2">Update status</h2>
            <form method="POST" action="/admin/admissions/<%= application.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label class="form-label" for="status">New status</label>
                <select id="status" name="status" class="form-control" required>
                  <% transitions.forEach(function(s) { %>
                    <option value="<%= s %>"><%= s %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="admin_notes">Admin notes (visible to applicant if requesting info)</label>
                <textarea id="admin_notes" name="admin_notes" class="form-control" rows="3"><%= application.admin_notes || '' %></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Save status</button>
            </form>
          </div>
        <% } else { %>
          <p class="text-muted">No further status changes available for this application.</p>
        <% } %>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
