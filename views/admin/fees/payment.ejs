<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Record Payment | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Record payment</div>
        </div>
        <a href="/admin/fees/bills" class="btn btn-outline btn-sm">Back</a>
      </header>
      <div class="page-content">
        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="card mb-4" style="max-width:480px;">
          <p><strong><%= bill.last_name %> <%= bill.first_name %></strong> (<%= bill.student_code %>)</p>
          <p class="mt-2"><%= bill.fee_name %> · <span class="badge <%= statusBadgeClass(bill.status) %>"><%= bill.status %></span></p>
          <p class="mt-2">Amount due: ₦<%= Number(bill.amount_due).toLocaleString() %></p>
          <p class="mt-1">Paid: ₦<%= Number(bill.amount_paid).toLocaleString() %></p>
          <p class="mt-1"><strong>Outstanding: ₦<%= (Number(bill.amount_due) - Number(bill.amount_paid)).toLocaleString() %></strong></p>
        </div>
        <div class="card" style="max-width:480px;">
          <form method="POST" action="/admin/fees/bills/<%= bill.id %>/pay">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="amount">Amount (₦)</label>
              <input type="number" id="amount" name="amount" class="form-control" required min="0.01" step="0.01"
                     value="<%= (Number(bill.amount_due) - Number(bill.amount_paid)).toFixed(2) %>">
            </div>
            <div class="form-group">
              <label class="form-label" for="payment_method">Method</label>
              <select id="payment_method" name="payment_method" class="form-control">
                <option value="cash">Cash</option>
                <option value="transfer">Bank transfer</option>
                <option value="pos">POS</option>
                <option value="cheque">Cheque</option>
                <option value="gateway">Online gateway</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="payment_reference">External reference (optional)</label>
              <input type="text" id="payment_reference" name="payment_reference" class="form-control" placeholder="Bank ref / teller no.">
            </div>
            <div class="form-group">
              <label class="form-label" for="notes">Notes</label>
              <input type="text" id="notes" name="notes" class="form-control">
            </div>
            <button type="submit" class="btn btn-primary">Record payment & issue receipt</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
