<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Biometric Events | PSHA</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Biometric events</div>
        </div>
        <div class="flex gap-2">
          <form method="POST" action="/admin/attendance/events/process">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-outline btn-sm">Process pending</button>
          </form>
          <a href="/admin/attendance/simulate" class="btn btn-primary btn-sm">Simulate event</a>
        </div>
      </header>
      <div class="page-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %>" data-auto-dismiss><%= flash.message %></div>
        <% } %>
        <div class="card">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr><th>Time</th><th>Staff ID</th><th>Type</th><th>Device</th><th>Processed</th></tr>
              </thead>
              <tbody>
                <% if (!events.length) { %>
                  <tr><td colspan="5" class="text-center text-muted">No events yet.</td></tr>
                <% } %>
                <% events.forEach(function(e) { %>
                  <tr>
                    <td><%= formatDate(e.event_timestamp) %></td>
                    <td><code><%= e.staff_id %></code></td>
                    <td><span class="badge badge-info"><%= e.event_type %></span></td>
                    <td><%= e.device_name || e.device_code || '—' %></td>
                    <td><span class="badge <%= e.processed ? 'badge-success' : 'badge-warning' %>"><%= e.processed ? 'Yes' : 'Pending' %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
