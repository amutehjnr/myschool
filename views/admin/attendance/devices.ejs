<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devices | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle>☰</button>
          <div style="font-weight:600;">Attendance devices</div>
        </div>
        <div class="flex gap-2">
          <a href="/admin/attendance/events" class="btn btn-outline btn-sm">Events</a>
          <a href="/admin/attendance/teachers" class="btn btn-outline btn-sm">Teacher logs</a>
          <a href="/admin/attendance/simulate" class="btn btn-outline btn-sm">Simulate</a>
          <a href="/admin/attendance/devices/new" class="btn btn-primary btn-sm">Register device</a>
        </div>
      </header>
      <div class="page-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
          <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %>" data-auto-dismiss><%= flash.message %></div>
        <% } %>
        <div class="card">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr><th>Code</th><th>Name</th><th>Location</th><th>Type</th><th>Active</th><th>Last seen</th></tr>
              </thead>
              <tbody>
                <% if (!devices.length) { %>
                  <tr><td colspan="6" class="text-center text-muted">No devices registered.</td></tr>
                <% } %>
                <% devices.forEach(function(d) { %>
                  <tr>
                    <td><code><%= d.device_code %></code></td>
                    <td><%= d.name %></td>
                    <td><%= d.location || '—' %></td>
                    <td><%= d.device_type %></td>
                    <td><span class="badge <%= d.is_active ? 'badge-success' : 'badge-secondary' %>"><%= d.is_active ? 'Yes' : 'No' %></span></td>
                    <td class="text-muted"><%= d.last_seen_at ? formatDate(d.last_seen_at) : 'Never' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
