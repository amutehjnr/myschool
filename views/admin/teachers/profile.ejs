<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | PSHA Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="dashboard-layout">
    <%- include('../../partials/admin-sidebar') %>
    <div class="main-content">
      <header class="top-navbar">
        <div class="flex items-center gap-4">
          <button class="mobile-menu-btn" data-sidebar-toggle aria-label="Toggle menu">☰</button>
          <div style="font-weight:600;">Teacher profile</div>
        </div>
        <div class="flex gap-2">
          <a href="/admin/teachers/<%= teacher.id %>/edit" class="btn btn-primary btn-sm">Edit</a>
          <a href="/admin/teachers" class="btn btn-outline btn-sm">Back</a>
        </div>
      </header>
      <div class="page-content">
        <div class="flex items-center gap-4 mb-4">
          <%- include('../../partials/passport', { photo: teacher.photo_path, name: teacher.first_name + ' ' + teacher.last_name, size: 96 }) %>
        </div>

        <div class="card mb-4">
          <div class="flex justify-between items-center" style="flex-wrap:wrap;gap:12px;">
            <div>
              <h1 style="font-size:1.35rem;font-weight:600;"><%= teacher.first_name %> <%= teacher.last_name %></h1>
              <p class="text-muted"><%= teacher.staff_id %> · <%= teacher.email %></p>
            </div>
            <% if (teacher.is_active) { %><span class="badge badge-success">Active</span>
            <% } else { %><span class="badge badge-danger">Inactive</span><% } %>
          </div>
          <div class="stats-grid" style="margin-top:20px;">
            <div><div class="text-muted" style="font-size:0.75rem;">Department</div><div><%= teacher.department_name || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Phone</div><div><%= teacher.phone || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Qualification</div><div><%= teacher.qualification || '—' %></div></div>
            <div><div class="text-muted" style="font-size:0.75rem;">Employment</div><div><%= teacher.employment_date ? formatDate(teacher.employment_date) : '—' %></div></div>
          </div>
        </div>
        <div class="flex gap-4" style="flex-wrap:wrap;">
          <div class="card" style="flex:1;min-width:240px;">
            <h2 class="card-title mb-2">Subjects</h2>
            <% if (!teacher.subjects || !teacher.subjects.length) { %><p class="text-muted">None assigned</p>
            <% } else { %><ul style="padding-left:18px;"><% teacher.subjects.forEach(function(s) { %><li><%= s.name %> (<%= s.code %>)</li><% }) %></ul><% } %>
          </div>
          <div class="card" style="flex:1;min-width:240px;">
            <h2 class="card-title mb-2">Classes</h2>
            <% if (!teacher.classes || !teacher.classes.length) { %><p class="text-muted">None assigned</p>
            <% } else { %><ul style="padding-left:18px;"><% teacher.classes.forEach(function(c) { %><li><%= c.name %><% if (c.is_class_teacher) { %> <span class="badge badge-info">Class teacher</span><% } %></li><% }) %></ul><% } %>
          </div>
        </div>
        <div class="card mt-4">
          <h2 class="card-title mb-2">Recent attendance</h2>
          <div class="table-responsive">
            <table class="table">
              <thead><tr><th>Date</th><th>Check-in</th><th>Check-out</th><th>Status</th></tr></thead>
              <tbody>
                <% if (!teacher.attendance || !teacher.attendance.length) { %>
                  <tr><td colspan="4" class="text-muted text-center">No attendance records yet.</td></tr>
                <% } else { teacher.attendance.forEach(function(a) { %>
                  <tr>
                    <td><%= formatDate(a.attendance_date) %></td>
                    <td><%= a.check_in_time ? formatTime(a.check_in_time) : '—' %></td>
                    <td><%= a.check_out_time ? formatTime(a.check_out_time) : '—' %></td>
                    <td><span class="badge <%= statusBadgeClass(a.status) %>"><%= a.status %></span></td>
                  </tr>
                <% }) } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
